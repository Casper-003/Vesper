<UserControl x:Class="Vesper.App.EntityDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vesper.App"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
  <UserControl.Resources>
    <SolidColorBrush x:Key="EntityAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
    <Style x:Key="EntitySongContainerStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="MaxWidth" Value="1120"/>
      <Setter Property="UseSystemFocusVisuals" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
            Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
            CornerRadius="8" Control.IsTemplateFocusTarget="True"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="EntityPage" SizeChanged="OnPageSizeChanged">
    <ListView x:Name="EntitySongs" Margin="24,48,24,12" SelectionMode="None"
        IsItemClickEnabled="True" ItemClick="OnSongClick" ItemContainerStyle="{StaticResource EntitySongContainerStyle}"
        ScrollViewer.IsScrollInertiaEnabled="True" ScrollViewer.IsDeferredScrollingEnabled="False"
        ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
      <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
      <ListView.Header>
        <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">
          <Grid x:Name="EntityHeaderSpace" Height="280"/>
          <TextBlock x:Name="TrackOrderNote" Margin="8,0,8,16" FontSize="12" TextWrapping="Wrap"
              Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock x:Name="EntitySongHeading" Text="歌曲" FontSize="20" FontWeight="SemiBold" Margin="8,0,8,12"/>
          <StackPanel x:Name="EntityEmptyState" Margin="8,16,8,28" Spacing="8" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8D6;" FontSize="36" HorizontalAlignment="Left"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="暂无可显示的本地歌曲" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </ListView.Header>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:EntitySongRow">
          <Grid ColumnSpacing="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Number, Mode=OneWay}" Visibility="{x:Bind NumberVisibility, Mode=OneWay}"
                Width="44" FontSize="12" TextAlignment="Center" VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ContentControl Grid.Column="1" Content="{x:Bind Song, Mode=OneWay}"
                ContentTemplate="{x:Bind SongTemplate, Mode=OneWay}" HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center" IsTabStop="False"/>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
      <ListView.Footer>
        <StackPanel x:Name="RelatedAlbumsSection" Spacing="12" Margin="8,24,8,16"
            MaxWidth="1120" HorizontalAlignment="Stretch" Visibility="Collapsed">
          <TextBlock Text="相关专辑" FontSize="20" FontWeight="SemiBold"/>
          <ItemsControl x:Name="RelatedAlbums">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Horizontal" ItemWidth="216" ItemHeight="88"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:EntityAlbumCard">
                <Button Click="OnAlbumClick" Width="208" Height="80" Padding="8" Margin="0,0,8,8"
                    HorizontalContentAlignment="Stretch" Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                      <Grid>
                        <FontIcon Glyph="&#xE93C;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"/>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" Visibility="{x:Bind CoverVisibility, Mode=OneWay}"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{x:Bind Artist, Mode=OneWay}" Visibility="{x:Bind ArtistVisibility, Mode=OneWay}"
                          FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ListView.Footer>
    </ListView>
    <Grid x:Name="EntityHeroLayer" Height="260" VerticalAlignment="Top" IsHitTestVisible="False">
      <Grid Background="{StaticResource EntityAccentBrush}"><Border Background="#33000000"/></Grid>
      <Border x:Name="EntityCoverFrame" Width="140" Height="140" Margin="32,60,0,0"
          HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4"
          Background="{ThemeResource ControlFillColorSecondaryBrush}">
        <Grid>
          <FontIcon x:Name="EntityCoverPlaceholder" Glyph="&#xE93C;" FontSize="44"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
          <Image x:Name="EntityCover" Stretch="UniformToFill" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <Canvas x:Name="EntityTitleMotion" Margin="196,0,0,0">
        <TextBlock x:Name="EntityHeroTitle" Canvas.Left="0" FontSize="96" LineHeight="116"
            FontWeight="Bold" Foreground="White"/>
      </Canvas>
      <TextBlock x:Name="EntitySubtitle" Margin="196,0,32,12" FontSize="14" Foreground="White"
          VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
    </Grid>
    <Grid x:Name="EntityScrollRail" Width="16" HorizontalAlignment="Right" Background="Transparent" Visibility="Collapsed">
      <primitives:ScrollBar x:Name="EntityScrollBar" Margin="1,0" Orientation="Vertical"
          IndicatorMode="None" IsTabStop="False" AutomationProperties.Name="详情滚动条"/>
    </Grid>
  </Grid>
</UserControl>
