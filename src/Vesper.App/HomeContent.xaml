<UserControl
    x:Class="Vesper.App.HomeContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RackChassisBackground" Color="#1F2227"/>
          <SolidColorBrush x:Key="RackChassisBorder" Color="#353942"/>
          <SolidColorBrush x:Key="RackTopHighlight" Color="#14FFFFFF"/>
          <SolidColorBrush x:Key="RackScrewBrush" Color="#4A4F5C"/>
          <SolidColorBrush x:Key="RackWellBackground" Color="#15171B"/>
          <SolidColorBrush x:Key="RackWellBorder" Color="#2C3039"/>
          <SolidColorBrush x:Key="RackMutedTextBrush" Color="#9AA3B2"/>
          <SolidColorBrush x:Key="RackBadgeBackground" Color="#2A2E36"/>
          <SolidColorBrush x:Key="RackBadgeForeground" Color="#D4DBE6"/>
          <SolidColorBrush x:Key="RackDisabledBackground" Color="#191C21"/>
          <SolidColorBrush x:Key="RackDisabledBorder" Color="#282C34"/>
          <SolidColorBrush x:Key="RackDisabledTextBrush" Color="#6F7787"/>
          <SolidColorBrush x:Key="ModeInactiveBackground" Color="#252830"/>
          <SolidColorBrush x:Key="ModeInactiveForeground" Color="#B6BFCE"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RackChassisBackground" Color="#EDF0F4"/>
          <SolidColorBrush x:Key="RackChassisBorder" Color="#C7CED9"/>
          <SolidColorBrush x:Key="RackTopHighlight" Color="#CCFFFFFF"/>
          <SolidColorBrush x:Key="RackScrewBrush" Color="#9CA5B4"/>
          <SolidColorBrush x:Key="RackWellBackground" Color="#DCE1E8"/>
          <SolidColorBrush x:Key="RackWellBorder" Color="#B6BECA"/>
          <SolidColorBrush x:Key="RackMutedTextBrush" Color="#566070"/>
          <SolidColorBrush x:Key="RackBadgeBackground" Color="#D8DEE8"/>
          <SolidColorBrush x:Key="RackBadgeForeground" Color="#2A313D"/>
          <SolidColorBrush x:Key="RackDisabledBackground" Color="#E2E6EC"/>
          <SolidColorBrush x:Key="RackDisabledBorder" Color="#C5CCD6"/>
          <SolidColorBrush x:Key="RackDisabledTextBrush" Color="#7D8696"/>
          <SolidColorBrush x:Key="ModeInactiveBackground" Color="#DFE4EC"/>
          <SolidColorBrush x:Key="ModeInactiveForeground" Color="#3C4554"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Style x:Key="RackModuleStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{ThemeResource RackChassisBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource RackChassisBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>

      <Style x:Key="RackWellStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{ThemeResource RackWellBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource RackWellBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>

      <Style x:Key="DspPlaceholderButtonStyle" TargetType="Button">
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource RackDisabledBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource RackDisabledBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{ThemeResource RackDisabledTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid x:Name="ConsoleRoot" RowSpacing="16" SizeChanged="OnConsoleSizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 上方：数字功放状态显示屏 -->
    <Border Style="{StaticResource RackModuleStyle}" Padding="16,14">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 机架丝印标识条与螺丝装饰 -->
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{ThemeResource RackScrewBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="VESPER KTV // DIGITAL MIXER CONSOLE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{ThemeResource RackMutedTextBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{ThemeResource RackBadgeBackground}" CornerRadius="4" Padding="7,2">
              <TextBlock Text="24-BIT WASAPI" FontSize="10" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource RackBadgeForeground}"/>
            </Border>
            <Ellipse Width="7" Height="7" Fill="{ThemeResource RackScrewBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- 烟熏黑 OLED 数字显示屏 -->
        <Border Grid.Row="1" CornerRadius="8" Background="#101318" BorderBrush="#262C36" BorderThickness="1" Padding="18,14">
          <Grid x:Name="DisplayScreenGrid" ColumnSpacing="18" RowSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.2*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="1.2*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 系统指示灯与实时状态 -->
            <StackPanel x:Name="DisplayStatusCell" Grid.Row="0" Grid.Column="0" Spacing="5" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="StatusLed" Width="10" Height="10" Fill="#EF4444" VerticalAlignment="Center"/>
                <TextBlock x:Name="DisplayStatusCode" Text="STANDBY" FontSize="12" FontWeight="Bold" FontFamily="Consolas" CharacterSpacing="60" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                <Border x:Name="DisplayModeBadge" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" Padding="6,1">
                  <TextBlock x:Name="DisplayModeLabel" Text="共享低延迟" FontSize="11" Foreground="#39C5BB"/>
                </Border>
              </StackPanel>
              <TextBlock x:Name="DisplayStatusDetail" Text="等待初始化音频设备…" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="DisplayPeriodText" Text="ENGINE: READY" FontSize="11" FontFamily="Consolas" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border x:Name="DisplayDivider1" Grid.Row="0" Grid.Column="1" Width="1" Background="#232934" Margin="0,2"/>

            <!-- 输入/输出硬件路由读数 -->
            <StackPanel x:Name="DisplayRoutingCell" Grid.Row="0" Grid.Column="2" Spacing="5" VerticalAlignment="Center">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="MIC IN" FontSize="11" FontFamily="Consolas" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock x:Name="DisplayInputName" Grid.Column="1" Text="未选择麦克风" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="VOX OUT" FontSize="11" FontFamily="Consolas" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock x:Name="DisplayOutputName" Grid.Column="1" Text="未选择输出设备" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="STAGE" FontSize="11" FontFamily="Consolas" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock x:Name="DisplayStageSummary" Grid.Column="1" Text="待播 0 首" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </StackPanel>

            <Border x:Name="DisplayDivider2" Grid.Row="0" Grid.Column="3" Width="1" Background="#232934" Margin="0,2"/>

            <!-- 快捷开唱入口 -->
            <StackPanel x:Name="DisplayActionCell" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
              <Button x:Name="QuickSingButton" Click="OnQuickSingClicked" Height="38" Padding="18,0" CornerRadius="8" Background="#39C5BB" Foreground="#0B1414" FontWeight="SemiBold" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon x:Name="QuickSingGlyph" Glyph="&#xE768;" FontSize="14"/>
                  <TextBlock x:Name="QuickSingLabel" Text="开始演唱" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="DisplayQueueHint" Text="队列待命" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- 下方：左区 MIC / 人声通道 ＋ 右区 BGM / 伴奏与主控通道 -->
    <Grid x:Name="ChannelsGrid" Grid.Row="1" ColumnSpacing="16" RowSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 下方左区：CH 01 · MIC / 人声通道 -->
      <Border x:Name="MicChannelCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource RackModuleStyle}" Padding="18,16">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 通道头：CH 01 + 刷新 + 耳返开关 -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Background="{ThemeResource RackBadgeBackground}" CornerRadius="5" Padding="8,3">
                <TextBlock Text="CH 01" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{ThemeResource RackBadgeForeground}"/>
              </Border>
              <StackPanel Spacing="1">
                <TextBlock Text="MIC / 人声通道" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="即时干声返听与实时试麦电平" FontSize="12" Foreground="{ThemeResource RackMutedTextBrush}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button x:Name="RefreshDevicesButton" Width="34" Height="34" Padding="0" CornerRadius="6" Click="OnRefreshDevicesClicked" ToolTipService.ToolTip="刷新音频设备" AutomationProperties.Name="刷新音频设备">
                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
              </Button>
              <Button x:Name="MonitoringToggleButton" Height="34" Padding="12,0" CornerRadius="6" Click="OnMonitoringToggleClicked" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Ellipse x:Name="MonitoringButtonLed" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
                  <TextBlock x:Name="MonitoringToggleLabel" Text="开启实时返听" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- 输入输出设备选择 -->
          <Grid x:Name="DeviceSelectorsGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ComboBox x:Name="InputDeviceBox" Header="麦克风输入" HorizontalAlignment="Stretch" SelectionChanged="OnInputDeviceChanged"/>
            <ComboBox x:Name="OutputDeviceBox" Grid.Column="1" Header="人声输出（耳机／音箱）" HorizontalAlignment="Stretch" SelectionChanged="OnOutputDeviceChanged"/>
          </Grid>

          <!-- 音量控制与实时电平灯柱 -->
          <Border Grid.Row="2" Style="{StaticResource RackWellStyle}" Padding="14,12">
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid x:Name="VocalVolumeHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Grid x:Name="MicMeterHost" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- 通道状态与防啸叫提示 -->
          <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock x:Name="MonitoringStatusText" Text="返听已关闭" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="使用音箱时请从较低音量开始，避免麦克风与音箱形成啸叫。" FontSize="11" Foreground="{ThemeResource RackMutedTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 下方右区：CH 02 · BGM / 伴奏与主控通道 -->
      <Border x:Name="BgmChannelCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource RackModuleStyle}" Padding="18,16">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 通道头：CH 02 -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Background="{ThemeResource RackBadgeBackground}" CornerRadius="5" Padding="8,3">
                <TextBlock Text="CH 02" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{ThemeResource RackBadgeForeground}"/>
              </Border>
              <StackPanel Spacing="1">
                <TextBlock Text="BGM / 伴奏与主控通道" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="伴奏电平、引擎模式与 KTV 效果器" FontSize="12" Foreground="{ThemeResource RackMutedTextBrush}"/>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{ThemeResource RackBadgeBackground}" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
              <TextBlock Text="MASTER" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{ThemeResource RackBadgeForeground}"/>
            </Border>
          </Grid>

          <!-- 音频模式切换 -->
          <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="音频模式" FontSize="13"/>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="LowLatencyModeButton" Content="共享低延迟" HorizontalAlignment="Stretch" Height="34" CornerRadius="6" Click="OnLowLatencyModeClicked"/>
              <Button x:Name="ExclusiveModeButton" Grid.Column="1" Content="独占模式" HorizontalAlignment="Stretch" Height="34" CornerRadius="6" Click="OnExclusiveModeClicked"/>
            </Grid>
          </StackPanel>

          <!-- 伴奏音量控制与未开放 KTV 效果器占位 -->
          <Border Grid.Row="2" Style="{StaticResource RackWellStyle}" Padding="14,12">
            <Grid x:Name="BgmWellGrid" ColumnSpacing="14" RowSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid x:Name="BgmVolumeHost" MinWidth="104" HorizontalAlignment="Center" VerticalAlignment="Center"/>

              <!-- KTV 进阶硬件占位区 -->
              <StackPanel x:Name="DspRackPanel" Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                <Grid>
                  <TextBlock Text="KTV 效果器（硬件机架占位）" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource RackMutedTextBrush}" VerticalAlignment="Center"/>
                  <Border HorizontalAlignment="Right" Background="{ThemeResource RackDisabledBackground}" BorderBrush="{ThemeResource RackDisabledBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                    <TextBlock Text="尚未开放" FontSize="10" Foreground="{ThemeResource RackDisabledTextBrush}"/>
                  </Border>
                </Grid>

                <StackPanel Spacing="4">
                  <TextBlock Text="原／伴唱切换 · VOCAL CUT" FontSize="11" Foreground="{ThemeResource RackDisabledTextBrush}"/>
                  <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="原唱" Style="{StaticResource DspPlaceholderButtonStyle}"/>
                    <Button Grid.Column="1" Content="伴奏" Style="{StaticResource DspPlaceholderButtonStyle}"/>
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="升降调 · KEY SHIFT" FontSize="11" Foreground="{ThemeResource RackDisabledTextBrush}"/>
                  <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="♭ 降调" Style="{StaticResource DspPlaceholderButtonStyle}"/>
                    <Button Grid.Column="1" Content="♮ 原调" Style="{StaticResource DspPlaceholderButtonStyle}"/>
                    <Button Grid.Column="2" Content="♯ 升调" Style="{StaticResource DspPlaceholderButtonStyle}"/>
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="4">
                  <Grid>
                    <TextBlock Text="混响预设 · REVERB DSP" FontSize="11" Foreground="{ThemeResource RackDisabledTextBrush}"/>
                    <TextBlock Text="0%" HorizontalAlignment="Right" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource RackDisabledTextBrush}"/>
                  </Grid>
                  <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="干声" Style="{StaticResource DspPlaceholderButtonStyle}"/>
                    <Button Grid.Column="1" Content="KTV" Style="{StaticResource DspPlaceholderButtonStyle}"/>
                    <Button Grid.Column="2" Content="音乐厅" Style="{StaticResource DspPlaceholderButtonStyle}"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- 模式说明 -->
          <Border Grid.Row="3" Background="{ThemeResource RackWellBackground}" BorderBrush="{ThemeResource RackWellBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
            <TextBlock x:Name="ModeUsageText" FontSize="12" Foreground="{ThemeResource RackMutedTextBrush}" TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
