<UserControl x:Class="Vesper.App.EntityDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vesper.App"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
  <UserControl.Resources>
    <LinearGradientBrush x:Key="EntityHeroBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#303034" Offset="0"/><GradientStop Color="#29292C" Offset="0.58"/><GradientStop Color="#242426" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="EntitySongContainerStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="MaxWidth" Value="1120"/>
      <Setter Property="UseSystemFocusVisuals" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
            Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
            CornerRadius="8" Control.IsTemplateFocusTarget="True"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="EntityPage" SizeChanged="OnPageSizeChanged">
    <ListView x:Name="EntitySongs" Margin="24,48,24,12" SelectionMode="None"
        IsItemClickEnabled="True" ItemClick="OnSongClick" ItemContainerStyle="{StaticResource EntitySongContainerStyle}"
        ScrollViewer.IsScrollInertiaEnabled="True" ScrollViewer.IsDeferredScrollingEnabled="False"
        ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
      <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
      <ListView.Header>
        <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">
          <Grid x:Name="EntityHeaderSpace" Height="280"/>
          <TextBlock x:Name="EntitySongHeading" Text="歌曲" FontSize="20" FontWeight="SemiBold" Margin="8,0,8,12"/>
          <Grid x:Name="AlbumColumnHeader" Visibility="Collapsed" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="#" Width="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="专辑曲序"/>
            <TextBlock Grid.Column="1" Text="歌曲" Margin="8,0,8,0" FontSize="14" FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </Grid>
          <StackPanel x:Name="EntityEmptyState" Margin="8,16,8,28" Spacing="8" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8D6;" FontSize="36" HorizontalAlignment="Left"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="暂无可显示的本地歌曲" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </ListView.Header>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:EntitySongRow">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Visibility="{x:Bind DiscHeadingVisibility, Mode=OneWay}" Padding="8,18,8,10" Background="Transparent"
                PointerPressed="OnDiscHeadingPointer" PointerReleased="OnDiscHeadingPointer">
              <TextBlock Text="{x:Bind DiscHeading, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Border>
            <Grid Grid.Row="1" ColumnSpacing="0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind Number, Mode=OneWay}" Visibility="{x:Bind NumberVisibility, Mode=OneWay}"
                  Width="44" FontSize="12" TextAlignment="Center" VerticalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <ContentControl Grid.Column="1" Content="{x:Bind Song, Mode=OneWay}"
                  ContentTemplate="{x:Bind SongTemplate, Mode=OneWay}" HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Center" IsTabStop="False"/>
            </Grid>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
      <ListView.Footer>
        <StackPanel x:Name="RelatedAlbumsSection" Spacing="12" Margin="8,24,8,16"
            MaxWidth="1120" HorizontalAlignment="Stretch" Visibility="Collapsed">
          <TextBlock Text="相关专辑" FontSize="20" FontWeight="SemiBold"/>
          <ItemsControl x:Name="RelatedAlbums">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Horizontal" ItemWidth="292" ItemHeight="128"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:EntityAlbumCard">
                <Button Click="OnAlbumClick" MaxWidth="280" Height="120" Padding="8" Margin="0,0,8,8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                      <Grid>
                        <FontIcon Glyph="&#xE93C;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"/>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" Visibility="{x:Bind CoverVisibility, Mode=OneWay}"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{x:Bind Artist, Mode=OneWay}" Visibility="{x:Bind ArtistVisibility, Mode=OneWay}"
                          FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ListView.Footer>
    </ListView>
    <Grid x:Name="EntityHeroLayer" Height="260" VerticalAlignment="Top" IsHitTestVisible="False">
      <Grid Background="{StaticResource EntityHeroBrush}"/>
      <Border x:Name="EntityCoverFrame" Width="240" Height="240" Margin="32,24,0,0"
          HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4"
          Background="{ThemeResource ControlFillColorSecondaryBrush}">
        <Grid>
          <FontIcon x:Name="EntityCoverPlaceholder" Glyph="&#xE93C;" FontSize="44"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
          <Image x:Name="EntityCover" Stretch="UniformToFill" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <Canvas x:Name="EntityTitleMotion" Margin="196,0,0,0">
        <TextBlock x:Name="EntityHeroTitle" Canvas.Left="0" FontSize="56" LineHeight="68"
            FontWeight="Bold" Foreground="White" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
      </Canvas>
      <TextBlock x:Name="EntitySubtitle" Margin="196,0,32,0" FontSize="14" Foreground="White"
          HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Top"
          TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
    </Grid>
    <Grid x:Name="EntityScrollRail" Width="16" HorizontalAlignment="Right" Background="Transparent" Visibility="Collapsed">
      <primitives:ScrollBar x:Name="EntityScrollBar" Margin="1,0" Orientation="Vertical"
          IndicatorMode="None" IsTabStop="False" AutomationProperties.Name="详情滚动条"/>
    </Grid>
  </Grid>
</UserControl>
