<UserControl
    x:Class="Vesper.App.HomeContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vesper.App">
  <UserControl.Resources>
    <local:BooleanToVisibilityConverter x:Key="Visible"/>
    <DataTemplate x:Key="CardTemplate" x:DataType="local:HomeCard">
      <StackPanel Width="{x:Bind Size}" Spacing="8" Opacity="{x:Bind CardOpacity, Mode=OneWay}">
        <Border Width="{x:Bind Size}" Height="{x:Bind Size}" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <Grid>
            <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="{x:Bind ImageStretch, Mode=OneWay}" Visibility="{x:Bind HasImage, Mode=OneWay, Converter={StaticResource Visible}}"/>
            <StackPanel Margin="16" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind NoImage, Mode=OneWay, Converter={StaticResource Visible}}">
              <FontIcon Glyph="{x:Bind Glyph}" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Spacing="3" MinHeight="42">
          <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" Visibility="{x:Bind HasImage, Mode=OneWay, Converter={StaticResource Visible}}"/>
          <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="{x:Bind Availability, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel x:Name="Shelves" Spacing="28"/>
</UserControl>
